[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.95"
description = "Constraint optimizer built with SolverForge"

[[bin]]
name = "{{crate_name}}"
path = "src/main.rs"

[dependencies]
solverforge = {{solverforge_dep}}
solverforge-ui = {{solverforge_ui_dep}}
solverforge-maps = {{solverforge_maps_dep}}
# Web server
axum = "0.8.9"
tokio = { version = "1.52.3", features = ["full"] }
tokio-stream = { version = "0.1.18", features = ["sync"] }
tower-http = { version = "0.6.11", features = ["fs", "cors"] }
tower = "0.5.3"

# Serialization
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.150"

# Utilities
uuid = { version = "1.23.5", features = ["v4", "serde"] }
parking_lot = "0.12.5"
